<mxCell id="c7" value="Module 2 · DCT-PLS  (temporal reconstruction)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#C27A00;strokeColor=#C27A00;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="c6"><mxGeometry x="0" y="0" width="720" height="30" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Weighting&lt;/b&gt;&lt;br&gt;&lt;i&gt;W&lt;/i&gt;: 1 = valid,&lt;br&gt;0 = missing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF4E3;strokeColor=#C27A00;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c6"><mxGeometry x="20" y="60" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Penalised least squares&lt;/b&gt;&lt;br&gt;min &lt;i&gt;F&lt;/i&gt; = ‖&lt;i&gt;W&lt;/i&gt;&lt;sup&gt;½&lt;/sup&gt;(&lt;i&gt;ŷ&lt;/i&gt; − &lt;i&gt;y&lt;/i&gt;)‖² + &lt;i&gt;s&lt;/i&gt;‖&lt;i&gt;Dŷ&lt;/i&gt;‖²&lt;br&gt;&lt;span style=&amp;quot;font-size:10px&amp;quot;&gt;D: Laplacian-type operator&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF4E3;strokeColor=#C27A00;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c6"><mxGeometry x="195" y="50" width="270" height="100" as="geometry"/></mxCell>
