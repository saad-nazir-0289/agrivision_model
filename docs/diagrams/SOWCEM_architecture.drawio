<mxCell id="c21" value="&lt;b&gt;Conversion coeff. &lt;i&gt;V&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;linear regression&lt;br&gt;fine vs coarse" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FDEEE6;strokeColor=#C0502A;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c17"><mxGeometry x="370" y="60" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Prediction&lt;/b&gt;&lt;br&gt;&lt;i&gt;F&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt;) = &lt;i&gt;F&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;m&lt;/sub&gt;) + Σ&lt;i&gt;W&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;i&gt;V&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;[&lt;i&gt;C&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt;) − &lt;i&gt;C&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;m&lt;/sub&gt;)]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FDEEE6;strokeColor=#C0502A;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c17"><mxGeometry x="380" y="190" width="320" height="80" as="geometry"/></mxCell>
