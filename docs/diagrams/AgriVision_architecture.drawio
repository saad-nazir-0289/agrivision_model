<mxCell id="c46" value="&lt;b&gt;Modules 5–6 · Loss &amp;amp; training&lt;/b&gt;&lt;br&gt;L1 + MS-SSIM on red, NIR&lt;br&gt;+ NDVI term computed &lt;i&gt;from predicted bands&lt;/i&gt;&lt;br&gt;Adam, lr 1e-3 · checkpoints to Drive" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="600" width="300" height="110" as="geometry"/></mxCell>
