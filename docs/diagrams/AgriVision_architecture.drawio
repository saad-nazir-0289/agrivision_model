<mxCell id="c50" value="The NDVI term is only a training signal. The NDVI map itself is still made last, in Module 9." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=2;fillColor=#FFFFFF;strokeColor=#9AA5B1;dashed=1;fontColor=#52606D;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1660" y="610" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;Module 7 · Inference&lt;/b&gt;&lt;br&gt;each MODIS-only day &lt;i&gt;t&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;:&lt;br&gt;nearest clear S2 (&lt;i&gt;F&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;) + &lt;i&gt;C&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;, &lt;i&gt;C&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;br&gt;256 px tiles, 32 px overlap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FDEEE6;strokeColor=#C0502A;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="c52" value="trained network → run on MODIS-only days" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="364"/><mxPoint x="1890" y="780"/><mxPoint x="165" y="780"/></Array></mxGeometry></mxCell>
<mxCell id="c53" value="&lt;b&gt;Optional · per-band blend&lt;/b&gt;&lt;br&gt;(SOWCEM idea, on reflectance)&lt;br&gt;model output + time guess per band&lt;br&gt;per-pixel weights &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;, &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF4E3;strokeColor=#C27A00;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="260" height="120" as="geometry"/></mxCell>
