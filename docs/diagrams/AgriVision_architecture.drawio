<mxCell id="c33" value="&lt;b&gt;Module 4 · Error vectors&lt;/b&gt;&lt;br&gt;&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt; = &lt;i&gt;z&lt;/i&gt; − &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;,&amp;nbsp;&amp;nbsp;&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = &lt;i&gt;z&lt;/i&gt; − &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;&lt;br&gt;over valid dates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c31"><mxGeometry x="30" y="50" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b&gt;Error information matrix&lt;/b&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;r&lt;/sub&gt; = &lt;i&gt;e&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;i&gt;e&lt;/i&gt; = [ Σ&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;²&amp;nbsp; Σ&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; ;&amp;nbsp; Σ&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;&amp;nbsp; Σ&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;² ]&amp;nbsp; (2×2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c31"><mxGeometry x="30" y="160" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;Module 5 · Constrained optimal weights&lt;/b&gt;&lt;br&gt;min &lt;i&gt;Q&lt;/i&gt; = &lt;i&gt;W&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;r&lt;/sub&gt;&lt;i&gt;W&lt;/i&gt;&lt;br&gt;s.t. &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt; + &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = 1,&amp;nbsp; &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;, &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; ≥ 0&lt;br&gt;&lt;span style=&amp;quot;font-size:10px&amp;quot;&gt;nonlinear programme&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c31"><mxGeometry x="30" y="270" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;Module 6 · Weighted combination&lt;/b&gt;&lt;br&gt;&lt;i&gt;ẑ&lt;/i&gt; = &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt; + &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;&lt;br&gt;applied to &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt;, &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; on every 5-day date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c31"><mxGeometry x="30" y="400" width="360" height="80" as="geometry"/></mxCell>
