<diagram id="page4" name="4 · Preprocessing in detail">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c1" value="&lt;b&gt;Module 2 · Preprocessing, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#1F2933;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry"/></mxCell>
<mxCell id="c2" value="Goal: make a MODIS image and a Sentinel-2 image of the same day comparable pixel by pixel. MODIS = Moderate Resolution Imaging Spectroradiometer." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#52606D;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1700" height="22" as="geometry"/></mxCell>
<mxCell id="c3" value="" style="rounded=0;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F1FB;strokeColor=#2F6DB5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1540" height="270" as="geometry"/></mxCell>
<mxCell id="c4" value="Sentinel-2 track  →  fine images" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#2F6DB5;strokeColor=#2F6DB5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="c3"><mxGeometry x="0" y="0" width="1540" height="30" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Input: Sentinel-2 Level-2A&lt;/b&gt;&lt;br&gt;surface reflectance&lt;br&gt;red, near-infrared (10 m)&lt;br&gt;+ Cloud Score+ (clear-sky score per pixel)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E8F1FB;strokeColor=#2F6DB5;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="55" width="230" height="160" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Step 1 · Cloud mask&lt;/b&gt;&lt;br&gt;• values ÷ 10 000 → reflectance (0–1)&lt;br&gt;• remove pixels with Cloud Score+ below 0.65&lt;br&gt;• grow removed areas by 3 pixels (hazy cloud edges)&lt;br&gt;• files from the European Space Agency since 2022: subtract 1000 first" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c3"><mxGeometry x="290" y="55" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Step 2 · Put on the common grid&lt;/b&gt;&lt;br&gt;• join tiles, cut to the study area&lt;br&gt;• one map projection (Universal Transverse Mercator)&lt;br&gt;• same corner point, 10 m pixels" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c3"><mxGeometry x="630" y="55" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Step 3 · Align dates&lt;/b&gt;&lt;br&gt;• reference = clearest date&lt;br&gt;• measure each date's offset from it (near-infrared)&lt;br&gt;• shift each date back" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c3"><mxGeometry x="970" y="55" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Fine images&lt;/b&gt;&lt;br&gt;Sentinel-2, 10 m&lt;br&gt;clouds masked&lt;br&gt;dates aligned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E6F5F4;strokeColor=#1F7F78;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c3"><mxGeometry x="1310" y="55" width="210" height="160" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value="" style="rounded=0;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1540" height="450" as="geometry"/></mxCell>
<mxCell id="c15" value="MODIS track  →  coarse images" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#3D8B37;strokeColor=#3D8B37;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="c14"><mxGeometry x="0" y="0" width="1540" height="30" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Input: MODIS daily reflectance&lt;/b&gt;&lt;br&gt;red, near-infrared&lt;br&gt;(~232 m pixels)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E8F1FB;strokeColor=#2F6DB5;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c14"><mxGeometry x="20" y="60" width="230" height="120" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;Input: MODIS quality data&lt;/b&gt;&lt;br&gt;cloud flags (1 km)&lt;br&gt;viewing angle" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E8F1FB;strokeColor=#2F6DB5;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c14"><mxGeometry x="20" y="230" width="230" height="120" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Step 4 · Cloud and view-angle mask&lt;/b&gt;&lt;br&gt;• values ÷ 10 000 → reflectance&lt;br&gt;• remove cloudy, shadowed and cloud-edge pixels&lt;br&gt;• drop days viewed more than 40° off vertical" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c14"><mxGeometry x="290" y="130" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Step 5 · Put on the common grid&lt;/b&gt;&lt;br&gt;• from MODIS's own ~232 m grid&lt;br&gt;• smooth (bilinear) redraw, twice:&lt;br&gt;• 250 m version → Step 6&lt;br&gt;• 10 m version → Step 7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c14"><mxGeometry x="630" y="130" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Step 6 · Estimate  (days both are clear, 250 m)&lt;/b&gt;&lt;br&gt;• position offset: shift Sentinel-2 until it matches&lt;br&gt;• blur: blur Sentinel-2 until it matches (measured, not removed)&lt;br&gt;• band factors: Sentinel-2 = a × MODIS + b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1EAFA;strokeColor=#6B3FA0;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c14"><mxGeometry x="970" y="45" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Step 7 · Apply  (every day, 10 m)&lt;/b&gt;&lt;br&gt;• shift into place: own offset on clear days, median of the 3 nearest clear days otherwise&lt;br&gt;• match bands: a × MODIS + b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5E8;strokeColor=#3D8B37;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="c14"><mxGeometry x="970" y="270" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Coarse images&lt;/b&gt;&lt;br&gt;MODIS, 10 m&lt;br&gt;in place, on Sentinel-2's scale&lt;br&gt;(still blurry, by design)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E6F5F4;strokeColor=#1F7F78;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="c14"><mxGeometry x="1310" y="270" width="210" height="150" as="geometry"/></mxCell>
<mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c26" value="250 m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="615"/><mxPoint x="990" y="570"/></Array></mxGeometry></mxCell>
<mxCell id="c27" value="10 m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="675"/><mxPoint x="990" y="785"/></Array></mxGeometry></mxCell>
<mxCell id="c28" value="offset, a, b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c30" value="aligned Sentinel-2 (clear days)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c31" value="&lt;b&gt;To Module 3 · Dataset&lt;/b&gt;&lt;br&gt;&lt;br&gt;fine + coarse images,&lt;br&gt;reflectance only&lt;br&gt;(no vegetation index yet)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E8F1FB;strokeColor=#2F6DB5;strokeWidth=1.5;fontColor=#1F2933;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="300" width="230" height="360" as="geometry"/></mxCell>
<mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#3E4C59;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1745" y="235"/></Array></mxGeometry></mxCell>
