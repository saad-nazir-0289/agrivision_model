<mxCell id="c39" value="Optional: 2nd reference pair (&lt;i&gt;C&lt;/i&gt;&lt;sub&gt;3&lt;/sub&gt;, &lt;i&gt;F&lt;/i&gt;&lt;sub&gt;3&lt;/sub&gt;) after &lt;i&gt;t&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;, weighted by how little MODIS changed.&lt;br&gt;Upgrades: dilated / U-Net change encoder, attention fusion; compare GAN-STFM, SwinSTFM, STFDiff." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=2;fillColor=#FFFFFF;strokeColor=#9AA5B1;dashed=1;fontColor=#52606D;align=left;spacing=6;" vertex="1" parent="c32"><mxGeometry x="20" y="310" width="220" height="115" as="geometry"/></mxCell>
